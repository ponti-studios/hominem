{
  "$schema": "https://turborepo.org/schema.json",
  "globalDependencies": ["package.json", "pnpm-lock.yaml", ".env", ".env.*"],
  "globalEnv": [
    "NODE_ENV",
    "ENV",
    "API_URL",
    "WEB_URL",
    "FINANCE_URL",
    "DATABASE_URL",
    "REDIS_URL",
    "BETTER_AUTH_SECRET",
    "HOMINEM_INTERNAL_API_URL",
    "PUBLIC_APP_URL",
    "AUTH_PASSKEY_RP_ID",
    "AUTH_PASSKEY_ORIGIN",
    "AUTH_COOKIE_DOMAIN",
    "AUTH_EMAIL_OTP_EXPIRES_SECONDS",
    "RESEND_API_KEY",
    "RESEND_FROM_EMAIL",
    "RESEND_FROM_NAME",
    "OPENROUTER_API_KEY",
    "CHAT_MODEL",
    "AUDIO_TTS_MODEL",
    "AUDIO_TTS_VOICE",
    "EMBEDDING_MODEL",
    "ENHANCE_MODEL",
    "TASK_EXTRACTION_MODEL",
    "TIME_BLOCK_EXTRACTION_MODEL",
    "VOICE_CLEANUP_MODEL",
    "R2_ENDPOINT",
    "R2_BUCKET_NAME",
    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY",
    "SERVICE_NAME",
    "OTEL_EXPORTER_OTLP_ENDPOINT",
    "OTEL_EXPORTER_OTLP_PROTOCOL",
    "OTEL_SERVICE_NAME",
    "OTEL_SERVICE_NAMESPACE",
    "OTEL_DEPLOYMENT_ENVIRONMENT",
    "OTEL_TRACES_SAMPLER_ARG",
    "OTEL_LOGS_EXPORTER",
    "VITE_PUBLIC_API_URL",
    "VITE_POSTHOG_HOST",
    "VITE_OTEL_DISABLED",
    "VITE_OTEL_SERVICE_NAME",
    "VITE_OTEL_SERVICE_VERSION",
    "VITE_OTEL_DEPLOYMENT_ENVIRONMENT",
    "VITE_OTEL_EXPORTER_OTLP_ENDPOINT",
    "VITE_OTEL_TRACES_SAMPLER_ARG",
    "EXPO_PUBLIC_API_BASE_URL",
    "EXPO_PUBLIC_POSTHOG_API_KEY",
    "EXPO_PUBLIC_POSTHOG_HOST",
    "OTEL_EXPORTER_OTLP_HEADERS",
    "OTEL_EXPORTER_OTLP_LOGS_ENDPOINT",
    "OTEL_EXPORTER_OTLP_LOGS_HEADERS",
    "EXPO_PUBLIC_NEWRELIC_IOS_APP_TOKEN",
    "NEWRELIC_USER_API_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "../../.env", "../../.env.*"],
      "outputs": ["dist/**", "build/**", ".react-router/**", "app/routes/+types/**/*"]
    },
    "@hominem/web#typecheck": {
      "dependsOn": ["^build", "@hominem/rpc#build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "../../.env", "../../.env.*"],
      "outputs": []
    },
    "@hominem/omiro#typecheck": {
      "dependsOn": ["^build", "@hominem/rpc#build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "../../.env", "../../.env.*"],
      "outputs": []
    },
    "@hominem/rpc#build": {
      "dependsOn": ["^build", "@hominem/api#build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "../../.env", "../../.env.*"],
      "outputs": ["dist/**", "build/**", ".react-router/**", "app/routes/+types/**/*"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "inputs": ["$TURBO_DEFAULT$", ".env*", "../../.env", "../../.env.*"]
    },
    "format": {
      "outputs": []
    },
    "format:check": {
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "lint:fix": {
      "outputs": []
    },
    "preview": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "../../.env", "../../.env.*"]
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", ".env*", "../../.env", "../../.env.*"]
    },
    "storybook": {
      "cache": false,
      "persistent": true,
      "inputs": ["$TURBO_DEFAULT$", ".env*", "../../.env", "../../.env.*"]
    },
    "build-storybook": {
      "inputs": ["$TURBO_DEFAULT$", ".env*", "../../.env", "../../.env.*"],
      "outputs": ["storybook-static/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "../../.env", "../../.env.*"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "../../.env", "../../.env.*"],
      "outputs": ["coverage/**"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true,
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "../../.env", "../../.env.*"],
      "outputs": []
    }
  }
}
