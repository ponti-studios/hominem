# Fly secrets template for hominem. NAMES ONLY, safe to commit.
#
# Copy this to a file OUTSIDE the repo (e.g. ~/hominem-fly.env), fill in the
# values, then tell Claude the path. Never commit the filled-in copy.
#
#   cp infra/fly/secrets.env.template ~/hominem-fly.env && chmod 600 ~/hominem-fly.env
#
# Anything stored in Railway is treated as compromised: generate NEW values.

# ── 1. YOU MUST GENERATE (new keys, the old ones are dead) ────────────────────

# Cloudflare dashboard -> R2 -> Manage API tokens -> Create token (Object Read & Write,
# scoped to the one bucket). Revoke the old token.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Same R2 page. Bucket name, S3 endpoint (https://<account-id>.r2.cloudflarestorage.com),
# and the public bucket / custom-domain URL. These are not secret, but unchanged
# values are fine to reuse from the old setup.
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_URL=

# resend.com -> API Keys -> Create (sending access only). Delete the old key.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=

# openrouter.ai -> Keys -> Create. Revoke the old one.
OPENROUTER_API_KEY=

# Auth signing secret, 32+ chars. Generate with:  openssl rand -hex 32
# NEW value signs everyone out. That is the point if the old one leaked.
BETTER_AUTH_SECRET=

# ── 2. YOUR REAL HOSTNAMES (decide before deploying) ──────────────────────────
# Without these the API falls back to *.lvh.me and auth redirects/cookies break.

API_URL=https://
WEB_URL=https://
CAREER_URL=https://
FINANCE_URL=https://
# Parent domain for the shared session cookie, e.g. .example.com
AUTH_COOKIE_DOMAIN=

# Web apps only (web, career, finance). The BROWSER-facing API URL, same as API_URL.
# This is also a BUILD arg: pass it to `fly deploy --build-arg` (see README).
VITE_PUBLIC_API_URL=https://
# Web apps only. The app's own public URL (web -> WEB_URL, career -> CAREER_URL, ...).
PUBLIC_APP_URL=https://

# ── 3. CLAUDE FILLS THESE IN (already generated, no action) ──────────────────
# DATABASE_URL         postgresql://postgres:<pw>@hominem-db.internal:5432/hominem
# REDIS_URL            redis://default:<pw>@hominem-redis.internal:6379
# HOMINEM_INTERNAL_API_URL   http://hominem-api.internal:4040   (web/career/finance)
# NODE_ENV, PORT       set in each fly.toml

# ── 4. OPTIONAL: only if you use the feature ──────────────────────────────────
# Skip any you do not use. Rotate and re-create any that lived in Railway.

# Finance app: R2 domain used by the browser (build arg for finance).
VITE_R2_DOMAIN=

# Per-user OpenRouter keys for Thames (needs a NEW management key if used).
OPENROUTER_MANAGEMENT_KEY=

# Stripe (only if CREDIT_MODE is not "off"). Roll the secret key and webhook secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Telegram private chat gateway. Set on both hominem-api and hominem-worker;
# TELEGRAM_WEBHOOK_SECRET is needed on hominem-api and may be duplicated safely.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_OWNER_USER_ID=

# PostHog (web analytics + the thames-top-up flag).
POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_PROJECT_TOKEN=

# OpenTelemetry export, if you send traces anywhere.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# App Store review sign-in (leave empty to keep it off).
APP_REVIEW_EMAIL=
APP_REVIEW_CODE=
APP_REVIEW_UNTIL=

# Thames TestFlight invite flow.
THAMES_TESTFLIGHT_URL=
THAMES_SITE_URL=
