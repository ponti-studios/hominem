# Fly production secrets template for Hominem. NAMES ONLY, safe to commit.
#
# Populate a copy outside the repo using the approved secret manager. Never
# commit, paste into chat, or otherwise share the filled-in copy.
#
#   cp infra/fly/secrets.env.template ~/hominem-fly.env && chmod 600 ~/hominem-fly.env
#
# Production endpoints and Fly app configuration are in the GitHub `Production`
# environment and private Notion operations reference. Do not copy secrets from
# local `.env` files.

# ── 1. CREDENTIALS (rotate only through an approved coordinated change) ───────

# Cloudflare dashboard -> R2 -> Manage API tokens -> Create token (Object Read & Write,
# scoped to the production bucket). Confirm the active Fly secret before rotation.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Same R2 page. Bucket name, S3 endpoint (https://<account-id>.r2.cloudflarestorage.com),
# and the public bucket / custom-domain URL. These are not secret, but unchanged
# values are fine to reuse from the old setup.
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_URL=

# resend.com -> API Keys -> Create (sending access only).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=

# openrouter.ai -> Keys -> Create.
OPENROUTER_API_KEY=

# Auth signing secret, 32+ chars. Generate with: openssl rand -hex 32
# Rotating this signs out existing sessions; coordinate before applying it.
BETTER_AUTH_SECRET=

# ── 2. PUBLIC ORIGINS ────────────────────────────────────────────────────────
# Set active service origins in the GitHub `Production` environment.

API_URL=https://
WEB_URL=https://
# Parent domain for the shared session cookie, e.g. .example.com
AUTH_COOKIE_DOMAIN=

# Web app build only (apps/web). The BROWSER-facing API URL, same as API_URL.
# This is also a BUILD arg: pass it to `fly deploy --build-arg` (see README).
VITE_PUBLIC_API_URL=https://
# Web server only. The app's own public URL, currently WEB_URL for Omiro.
PUBLIC_APP_URL=https://

# ── 3. PRIVATE SERVICE URLS ──────────────────────────────────────────────────
# DATABASE_URL         private database URL from the approved secret manager
# REDIS_URL            private Redis URL from the approved secret manager
# HOMINEM_INTERNAL_API_URL   private API URL from the approved secret manager
# NODE_ENV, PORT       set in each fly.toml

# ── 4. OPTIONAL: only if you use the feature ──────────────────────────────────
# Skip features that are not enabled. Do not copy credentials from retired hosting.

# Per-user OpenRouter keys for Thames (needs a NEW management key if used).
OPENROUTER_MANAGEMENT_KEY=

# Stripe (only if CREDIT_MODE is not "off"). Roll the secret key and webhook secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Telegram private chat gateway. Configure on the active API and worker apps;
# TELEGRAM_WEBHOOK_SECRET is needed on the API.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_OWNER_USER_ID=

# PostHog (web analytics + the thames-top-up flag).
POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_PROJECT_TOKEN=

# OpenTelemetry export, if you send traces anywhere.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# App Store review sign-in (leave empty to keep it off).
APP_REVIEW_EMAIL=
APP_REVIEW_CODE=
APP_REVIEW_UNTIL=

# Thames TestFlight invite flow.
THAMES_TESTFLIGHT_URL=
THAMES_SITE_URL=
