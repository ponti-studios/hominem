{
  "name": "@hominem/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./ai": {
      "types": "./build/ai.d.ts",
      "default": "./src/ai.ts"
    },
    "./career": {
      "types": "./build/career.d.ts",
      "default": "./src/career.ts"
    },
    "./chats": {
      "types": "./build/chats.d.ts",
      "default": "./src/chats.ts"
    },
    "./core": {
      "types": "./build/core.d.ts",
      "default": "./src/core.ts"
    },
    "./errors": {
      "types": "./build/errors.d.ts",
      "default": "./src/errors.ts"
    },
    "./files": {
      "types": "./build/files.d.ts",
      "default": "./src/files.ts"
    },
    "./finance": {
      "types": "./build/finance.d.ts",
      "default": "./src/finance.ts"
    },
    "./notes": {
      "types": "./build/notes.d.ts",
      "default": "./src/notes.ts"
    },
    "./possessions": {
      "types": "./build/possessions.d.ts",
      "default": "./src/possessions.ts"
    },
    "./tasks": {
      "types": "./build/tasks.d.ts",
      "default": "./src/tasks.ts"
    },
    "./types": {
      "types": "./build/types.d.ts",
      "default": "./src/types.ts"
    },
    "./transaction": {
      "types": "./build/transaction.d.ts",
      "default": "./src/transaction.ts"
    },
    "./vector": {
      "types": "./build/vector.d.ts",
      "default": "./src/vector.ts"
    },
    "./types/*": {
      "types": "./build/types/*.d.ts",
      "default": "./src/types/*.ts"
    },
    "./services/*": {
      "types": "./build/services/*.d.ts",
      "default": "./src/services/*.ts"
    },
    "./test/*": {
      "types": "./build/test/*.d.ts",
      "default": "./src/test/*.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc --watch --preserveWatchOutput",
    "typecheck": "rm -rf .cache && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "oxfmt src --write",
    "format:check": "oxfmt src --check",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix"
  },
  "dependencies": {
    "@hominem/chat": "workspace:*",
    "@hominem/env": "workspace:*",
    "@hominem/utils": "workspace:*",
    "kysely": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.11",
    "dotenv": "catalog:",
    "kysely-codegen": "^0.20.0",
    "vitest": "catalog:"
  }
}
