{
  "name": "@hominem/ai",
  "version": "0.0.0",
  "description": "AI and language model integration",
  "type": "module",
  "sideEffects": false,
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "rm -rf .cache && tsc --noEmit",
    "test": "vitest run src",
    "format": "oxfmt src --write",
    "format:check": "oxfmt src --check",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix"
  },
  "dependencies": {
    "@hominem/db": "workspace:*",
    "@hominem/env": "workspace:*",
    "@hominem/telemetry": "workspace:*",
    "@hominem/utils": "workspace:*",
    "@openrouter/sdk": "^1.2.113",
    "zod": "catalog:"
  }
}
