{
  "name": "@hominem/chat",
  "version": "0.0.0",
  "description": "Chat and messaging services",
  "type": "module",
  "sideEffects": false,
  "types": "./build/public.d.ts",
  "exports": {
    ".": {
      "types": "./build/public.d.ts",
      "default": "./src/public.ts"
    },
    "./types": {
      "types": "./build/types-only.d.ts",
      "default": "./src/types-only.ts"
    },
    "./ui": {
      "types": "./build/session-artifacts.d.ts",
      "default": "./src/session-artifacts.ts"
    },
    "./constants": {
      "types": "./build/constants.d.ts",
      "default": "./src/constants.ts"
    },
    "./sse": {
      "types": "./build/sse.d.ts",
      "default": "./src/sse.ts"
    },
    "./schemas": {
      "types": "./build/generation-schemas.d.ts",
      "default": "./src/generation-schemas.ts"
    },
    "./projection": {
      "types": "./build/projection.d.ts",
      "default": "./src/projection.ts"
    },
    "./server": {
      "types": "./build/server.d.ts",
      "default": "./src/server.ts"
    },
    "./client": {
      "types": "./build/client.d.ts",
      "default": "./src/client.ts"
    },
    "./transport/xhr": {
      "types": "./build/client-transport-xhr.d.ts",
      "default": "./src/client-transport-xhr.ts"
    },
    "./adapters/redis": {
      "types": "./build/redis-adapters.d.ts",
      "default": "./src/redis-adapters.ts"
    }
  },
  "scripts": {
    "build": "rm -rf build .cache && tsc -p tsconfig.json",
    "typecheck": "rm -rf .cache && tsc --noEmit",
    "test": "vitest run src --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "format": "oxfmt src --write",
    "format:check": "oxfmt src --check",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix"
  },
  "dependencies": {
    "date-fns": "^3.6.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@hominem/utils": "workspace:*",
    "@vitest/coverage-v8": "5.0.5",
    "react": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:"
  }
}
