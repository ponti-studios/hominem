{
  "name": "@hominem/rpc",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./src/index.ts"
    },
    "./fetch": {
      "types": "./build/fetch.d.ts",
      "default": "./src/fetch.ts"
    },
    "./finance": {
      "types": "./build/finance.d.ts",
      "default": "./src/finance.ts"
    },
    "./react": {
      "types": "./build/react/index.d.ts",
      "default": "./src/react/index.ts"
    },
    "./server": {
      "types": "./build/server.d.ts",
      "default": "./src/server.ts"
    },
    "./types": {
      "types": "./build/types/index.d.ts",
      "default": "./src/types/index.ts"
    },
    "./types/*": {
      "types": "./build/types/*.d.ts",
      "default": "./src/types/*.ts"
    },
    "./voice-events": {
      "types": "./build/voice-events.d.ts",
      "default": "./src/voice-events.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.emit.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "oxfmt src --write",
    "format:check": "oxfmt src --check",
    "typecheck": "rm -rf .cache && tsc --noEmit"
  },
  "dependencies": {
    "@hominem/api": "workspace:*",
    "@hominem/chat": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "hono": "catalog:",
    "undici": "^7.29.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.5",
    "react": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:"
  }
}
