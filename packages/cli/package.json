{
  "name": "@hominem/cli",
  "version": "0.0.0",
  "private": true,
  "description": "The hominem command: Google sign-in, token health, and the daily auth check",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && bun build --compile src/index.ts --outfile build/hominem",
    "dev": "bun run src/index.ts",
    "install:local": "bun run build && mkdir -p ~/.local/bin && cp build/hominem ~/.local/bin/hominem",
    "test": "vitest run src",
    "typecheck": "rm -rf .cache && tsc --noEmit",
    "format": "oxfmt src --write",
    "format:check": "oxfmt src --check",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
