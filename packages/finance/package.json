{
  "name": "@hominem/finance-services",
  "version": "0.0.0",
  "description": "Financial services and transaction management",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./build/*.d.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "rm -rf .cache && tsc --noEmit",
    "format": "pnpm exec oxfmt ./src --write",
    "format:check": "pnpm exec oxfmt ./src --check",
    "lint": "pnpm exec oxlint ./src",
    "lint:fix": "pnpm exec oxlint ./src --fix",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hominem/db": "workspace:*",
    "@hominem/utils": "workspace:*",
    "csv-parse": "^7.0.3",
    "kysely": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
