{
  "name": "@ponti-studios/auth",
  "version": "0.2.0",
  "description": "Unified authentication package for Hominem apps (web, mobile, CLI)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ponti-studios/hominem.git",
    "directory": "packages/auth"
  },
  "files": [
    "build"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./types": {
      "types": "./build/types.d.ts",
      "default": "./build/types.js"
    },
    "./shared/mask-email": {
      "types": "./build/shared/mask-email.d.ts",
      "default": "./build/shared/mask-email.js"
    },
    "./shared/validation": {
      "types": "./build/shared/validation.d.ts",
      "default": "./build/shared/validation.js"
    },
    "./shared/redirect-policy": {
      "types": "./build/shared/redirect-policy.d.ts",
      "default": "./build/shared/redirect-policy.js"
    },
    "./shared/protocol": {
      "types": "./build/shared/protocol.d.ts",
      "default": "./build/shared/protocol.js"
    },
    "./server": {
      "types": "./build/server.d.ts",
      "default": "./build/server.js"
    },
    "./testkit": {
      "types": "./build/testkit/index.d.ts",
      "default": "./build/testkit/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "rm -rf .cache && tsc --noEmit",
    "format": "oxfmt src --write",
    "format:check": "oxfmt src --check",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix"
  },
  "dependencies": {
    "@hominem/utils": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@playwright/test": "^1.62.1"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  }
}
