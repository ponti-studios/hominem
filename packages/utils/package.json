{
  "name": "@hominem/utils",
  "version": "0.0.0",
  "description": "utilities",
  "type": "module",
  "sideEffects": false,
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./src/index.ts"
    },
    "./dates": {
      "types": "./build/dates.d.ts",
      "default": "./src/dates.ts"
    },
    "./http": {
      "types": "./build/http.d.ts",
      "default": "./src/http.ts"
    },
    "./time": {
      "types": "./build/time.d.ts",
      "default": "./src/time.ts"
    },
    "./text": {
      "types": "./build/text.d.ts",
      "default": "./src/text.ts"
    },
    "./files": {
      "types": "./build/files.d.ts",
      "default": "./src/files.ts"
    },
    "./numbers": {
      "types": "./build/numbers.d.ts",
      "default": "./src/numbers.ts"
    },
    "./email": {
      "types": "./build/email/index.d.ts",
      "default": "./src/email/index.ts"
    },
    "./coerce": {
      "types": "./build/coerce.d.ts",
      "default": "./src/coerce.ts"
    },
    "./testing": {
      "types": "./build/testing.d.ts",
      "default": "./src/testing.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "rm -rf .cache && tsc --noEmit",
    "format": "oxfmt src --write",
    "format:check": "oxfmt src --check",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {},
  "devDependencies": {}
}
