{
  "name": "@hominem/storage",
  "version": "0.0.0",
  "description": "Storage services and upload policy",
  "type": "module",
  "sideEffects": false,
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./src/index.ts"
    },
    "./constants": {
      "types": "./build/upload-policy.d.ts",
      "default": "./src/upload-policy.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "rm -rf .cache && tsc --noEmit",
    "format": "oxfmt src --write",
    "format:check": "oxfmt src --check",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "@aws-sdk/s3-request-presigner": "^3.1153.0",
    "@hominem/env": "workspace:*",
    "@hominem/utils": "workspace:*",
    "file-type": "^22.2.0"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  }
}
