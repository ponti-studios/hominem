{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.mjs"],
      "project": ["scripts/**/*.mjs"]
    },
    "apps/omiro": {
      "entry": ["app/**/*.{ts,tsx}"],
      "project": ["**/*.{ts,tsx}"]
    },
    "apps/web": {
      "entry": ["app/routes/**/*.{ts,tsx}", "tests/e2e/*.{ts,tsx}"],
      "project": ["app/**/*.{ts,tsx}", "tests/**/*.ts"]
    },
    "services/api": {
      "entry": ["src/index.ts", "scripts/**/*.ts"],
      "project": ["src/**/*.{ts,tsx}", "scripts/**/*.ts"]
    },
    "services/evals": {
      "entry": [
        "runner/cli.ts",
        "runner/mcp-tool-catalog.ts",
        "**/*.suite.ts",
        "assertions/*.ts",
        "providers/*.ts",
        "seed/**/*.mts"
      ],
      "project": ["**/*.{ts,tsx,mts}"]
    },
    "packages/*": {
      "project": ["src/**/*.{ts,tsx}"]
    }
  },
  "ignoreDependencies": [
    "@expo/plist",
    "babel-preset-expo",
    "expo-build-properties",
    "expo-splash-screen",
    "expo-updates",
    "kysely-codegen",
    "tailwindcss",
    "tw-animate-css"
  ],
  "ignoreBinaries": ["eas"],
  "ignore": ["packages/*/build/**"],
  "ignoreUnresolved": ["^\\./\\+types/", "^@hominem/(finance-services/rulings|db/types)$"]
}
