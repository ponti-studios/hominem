{
  "$schema": "https://unpkg.com/knip@5/schema.json",

  "workspaces": {
    "apps/omiro": {
      "entry": ["app/**/*.{ts,tsx}"],
      "project": ["**/*.{ts,tsx}"]
    },

    "apps/career": {
      "project": ["app/**/*.{ts,tsx}"]
    },

    "services/api": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },

    "packages/*": {
      "project": ["src/**/*.{ts,tsx}"]
    }
  },

  "ignoreDependencies": [
    "babel-preset-expo",
    "tw-animate-css",
    "tailwindcss",
    "expo-updates",
    "@expo/plist"
  ],

  "ignoreBinaries": [],

  "ignoreUnresolved": ["^\\.\\/\\+types\\/"],

  "ignore": ["apps/omiro/components/**", "apps/omiro/services/**", "apps/omiro/modules/**"]
}
