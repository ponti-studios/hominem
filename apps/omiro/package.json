{
  "name": "@hominem/omiro",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "build:prod:local": "bash scripts/build-prod-local.sh",
    "build:install:device": "bash scripts/build-and-install-device.sh",
    "dev": "APP_ENV=development expo start --dev-client --ios",
    "eas-build-post-install": "pnpm --filter @ponti-studios/auth build",
    "eas:publish": "eas submit -p ios --profile production --path ./build/prod-local.ipa",
    "eas:pull:prod": "npx eas-cli env:pull production --path .eas-prod.local",
    "export:embed:ios": "pnpm --filter @ponti-studios/auth build && APP_ENV=production expo export:embed --eager --platform ios --dev false",
    "format": "oxfmt env.ts components app config constants hooks services tests types --write",
    "format:check": "oxfmt env.ts components app config constants hooks services tests types --check",
    "lint": "oxlint --config oxlint.config.mjs env.ts app components config constants hooks services tests types",
    "lint:fix": "oxlint --config oxlint.config.mjs env.ts app components config constants hooks services tests types --fix",
    "prebuild:dev": "APP_ENV=development pnpm exec expo prebuild --platform ios --clean",
    "prebuild:prod": "APP_ENV=production pnpm exec expo prebuild --platform ios --clean",
    "run:ios": "APP_ENV=development pnpm exec expo run:ios",
    "submit:local": "bash scripts/submit-prod-local.sh",
    "test": "vitest run --config vitest.config.ts",
    "test:maestro": "bash tests/scripts/maestro-command.sh",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "typecheck": "rm -rf .cache && tsc --noEmit -p tsconfig.json",
    "verify:release": "node scripts/verify-release-identity.mjs",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@expensify/react-native-live-markdown": "0.1.343",
    "@expo/ui": "~58.0.23",
    "@hominem/chat": "workspace:*",
    "@hominem/env": "workspace:*",
    "@hominem/rn-kit": "workspace:*",
    "@hominem/rpc": "workspace:*",
    "@hominem/storage": "workspace:*",
    "@hominem/telemetry": "workspace:*",
    "@hominem/utils": "workspace:*",
    "@ponti-studios/auth": "workspace:*",
    "@react-native-community/netinfo": "12.0.1",
    "@shopify/flash-list": "2.3.2",
    "@shopify/react-native-skia": "2.14.0",
    "@shopify/restyle": "^2.4.5",
    "@tanstack/query-sync-storage-persister": "5.104.5",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-query-persist-client": "5.104.5",
    "expo": "^58.0.19",
    "expo-application": "~58.1.2",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-build-properties": "~58.0.11",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.15",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-haptics": "^58.0.7",
    "expo-image": "~58.0.17",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-local-authentication": "^58.0.2",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.19",
    "expo-media-library": "~58.0.12",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.26",
    "expo-screen-capture": "^58.0.6",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "^58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.14",
    "expo-store-review": "^58.0.2",
    "expo-symbols": "^58.0.4",
    "expo-updates": "~58.0.18",
    "newrelic-react-native-agent": "^1.9.2",
    "posthog-react-native": "^4.81.4",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-error-boundary": "^6.1.6",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-markdown-display": "^7.0.2",
    "react-native-mmkv": "^4.2.0",
    "react-native-nitro-image": "^0.14.0",
    "react-native-nitro-modules": "0.37.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-vision-camera": "5.2.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@expo/plist": "^0.8.1",
    "@testing-library/react": "^16.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "babel-preset-expo": "58.0.20",
    "jsdom": "^30.1.3",
    "oxlint-config-universe": "^0.2.0",
    "typescript": "~7.0.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-dom"
      ]
    },
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      },
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-nitro-image",
          "omiro-intents",
          "voice-transcriber",
          "on-device-ai"
        ]
      }
    }
  }
}
