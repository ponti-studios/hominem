{
  "name": "@hominem/omiro",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "build:dev": "npx eas-cli build --platform ios --profile development",
    "build:e2e": "npx eas-cli build --platform ios --profile e2e",
    "build:prod": "node scripts/verify-release-identity.mjs && npx eas-cli build --platform ios --profile production",
    "build:screenshots": "npx eas-cli build --platform ios --profile screenshots",
    "dev": "APP_ENV=development expo start --clear",
    "eas-build-post-install": "pnpm --filter @ponti-studios/auth build",
    "export:embed:ios": "pnpm --filter @ponti-studios/auth build && APP_ENV=production expo export:embed --eager --platform ios --dev false",
    "format": "oxfmt env.ts components app config constants hooks services tests types --write",
    "format:check": "oxfmt env.ts components app config constants hooks services tests types --check",
    "lint": "oxlint --config oxlint.config.mjs env.ts app components config constants hooks services tests types",
    "lint:expo": "oxlint --config oxlint.config.mjs env.ts app components config constants hooks services tests types",
    "lint:fix": "oxlint --config oxlint.config.mjs env.ts app components config constants hooks services tests types --fix",
    "prebuild:dev": "APP_ENV=development pnpm exec expo prebuild --platform ios --clean",
    "prebuild:prod": "APP_ENV=production pnpm exec expo prebuild --platform ios --clean",
    "prebuild:screenshots": "APP_ENV=screenshots pnpm exec expo prebuild --platform ios --clean",
    "run:ios": "DEVELOPER_DIR=/Applications/Xcode-beta.app/Contents/Developer APP_ENV=development expo run:ios",
    "run:ios:e2e": "APP_ENV=e2e expo run:ios",
    "start:ios": "APP_ENV=development expo start --dev-client --ios",
    "submit": "node scripts/verify-release-identity.mjs && npx eas-cli submit --platform ios --profile production --latest",
    "test": "vitest run --config vitest.config.ts",
    "test:maestro": "bash tests/scripts/maestro-run.sh",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "typecheck": "rm -rf .cache && tsc --noEmit -p tsconfig.json",
    "update": "APP_ENV=production npx eas-cli update --branch production",
    "verify:release": "node scripts/verify-release-identity.mjs",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.1",
    "@expo/metro-runtime": "~57.0.12",
    "@expo/ui": "~57.0.13",
    "@hominem/chat": "workspace:*",
    "@hominem/env": "workspace:*",
    "@hominem/rpc": "workspace:*",
    "@hominem/storage": "workspace:*",
    "@hominem/telemetry": "workspace:*",
    "@hominem/utils": "workspace:*",
    "@ponti-studios/auth": "workspace:*",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react-native": "^8.23.0",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "2.6.2",
    "@shopify/restyle": "^2.4.5",
    "@tanstack/query-sync-storage-persister": "5.101.4",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-query-persist-client": "5.101.4",
    "better-auth": "catalog:",
    "expo": "^57.0.16",
    "expo-application": "~57.0.2",
    "expo-asset": "~57.0.14",
    "expo-audio": "~57.0.4",
    "expo-build-properties": "~57.0.14",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.14",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.14",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.5",
    "expo-font": "~57.0.1",
    "expo-haptics": "^57.0.1",
    "expo-image": "~57.0.3",
    "expo-image-picker": "~57.0.13",
    "expo-keep-awake": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-local-authentication": "^57.0.2",
    "expo-localization": "~57.0.1",
    "expo-location": "~57.0.13",
    "expo-media-library": "~57.0.4",
    "expo-network": "~57.0.1",
    "expo-router": "~57.0.16",
    "expo-screen-capture": "^57.0.2",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "^57.0.15",
    "expo-splash-screen": "~57.0.8",
    "expo-store-review": "^57.0.2",
    "expo-symbols": "^57.0.2",
    "expo-updates": "~57.0.17",
    "posthog-react-native": "^4.63.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-error-boundary": "^6.1.1",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "2.32.0",
    "react-native-keyboard-controller": "^1.21.9",
    "react-native-markdown-display": "^7.0.2",
    "react-native-mmkv": "^4.2.0",
    "react-native-nitro-image": "^0.14.0",
    "react-native-nitro-modules": "^0.36.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.27.0",
    "react-native-vision-camera": "^5.2.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@expo/plist": "^0.8.1",
    "@sentry/cli": "3.7.0",
    "@testing-library/react": "^16.3.0",
    "@vitest/coverage-v8": "4.1.11",
    "babel-preset-expo": "57.0.4",
    "jsdom": "^30.0.1",
    "oxlint-config-universe": "^0.2.0",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native"
      ]
    },
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      },
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-nitro-image",
          "omiro-intents",
          "voice-transcriber",
          "on-device-ai"
        ]
      }
    }
  }
}
