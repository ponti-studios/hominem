{
  "extends": "expo/tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    // App typechecking consumes emitted package declarations. Do not let a
    // stale local tsbuildinfo file hide changed exports in CI.
    "incremental": false,
    "tsBuildInfoFile": "./.cache/tsconfig.tsbuildinfo",
    // tsserver-only (ignored by `tsc --noEmit`): doesn't inherit from
    // tsconfig.base.json since this extends Expo's base config instead — see
    // tsconfig.base.json for why this is set repo-wide.
    "assumeChangesOnlyAffectDirectDependencies": true,
    "allowJs": true,
    "checkJs": false,
    "paths": {
      "expo-symbols": ["./node_modules/expo-symbols/build/index"],
      "@shopify/flash-list": ["./node_modules/@shopify/flash-list/dist/index"],
      "~/*": ["./*"],
      // react-native-live-markdown's main entry re-exports its default parser, which imports expensify-common
      // (a peer Omiro does not install, see pnpm-workspace.yaml), so the input is imported from its own source
      // file. Metro needs the source (React Native codegen reads the native component spec from it); tsc reads
      // the matching declarations rather than type-checking that source.
      "@expensify/react-native-live-markdown/src/MarkdownTextInput": [
        "./node_modules/@expensify/react-native-live-markdown/lib/typescript/src/MarkdownTextInput"
      ],
      // @hominem/api/types is type-only (see packages/rpc/src/core/api-client.ts)
      // and not a real dependency of this app or @hominem/rpc — see that
      // package's tsconfig.json for the same alias. Keep in sync with
      // services/api/package.json's "./types" export.
      //
      // @hominem/db, @hominem/career-services, @hominem/ai, and
      // @hominem/finance-services below aren't this app's own dependencies
      // either — services/api's build/rpc/app.d.ts (the Hono AppType)
      // preserves `import("@hominem/career-services").ResumeImportDiff`-
      // style references literally instead of inlining them, so every
      // consumer of that .d.ts has to resolve those specifiers itself and
      // hits the same injectWorkspacePackages trap services/api's own
      // tsconfig.emit.json already routes around for its own compile
      // (docs/type-performance.md).
      "@hominem/api/types": ["../../services/api/build/rpc/app.d.ts"],
      "@hominem/db": ["../../packages/db/build/index.d.ts"],
      "@hominem/career-services": ["../../packages/career/build/index.d.ts"],
      "@hominem/ai": ["../../packages/ai/build/index.d.ts"],
      "@hominem/finance-services": ["../../packages/finance/build/index.d.ts"]
    },
    "noEmit": true
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "hooks/**/*.ts",
    "modules/**/*.ts",
    "modules/**/*.tsx",
    "services/**/*.ts",
    "constants/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "app.config.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    ".turbo",
    ".cache",
    ".expo/web",
    "ios",
    "android",
    "coverage",
    "*.tsbuildinfo"
  ],
  "references": [
    { "path": "../../packages/auth" },
    { "path": "../../packages/chat" },
    { "path": "../../packages/env" },
    { "path": "../../packages/storage" },
    { "path": "../../packages/telemetry" },
    { "path": "../../packages/utils" }
  ]
}
