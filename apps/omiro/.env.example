# Copy this file to .env.development.local. EXPO_PUBLIC_* values are embedded
# into the client bundle; API URLs are public configuration, not credentials.
# For a physical device, replace localhost with a reachable LAN or tunnel URL.
#
# Do NOT set APP_ENV here. Every package.json script already prefixes the
# app environment explicitly (e.g. `APP_ENV=production expo prebuild`), and
# app.config.js refuses to guess it. An ambient APP_ENV in a .local file has
# previously caused a "production" build to silently ship the dev app
# identity to the App Store — see app.config.js's getAppEnvironment().
#
# Expo's built-in dotenv loading always reads .env.local in addition to
# .env.development.local, so secrets for local production builds live in
# .eas-prod.local instead. It's deliberately NOT named .env.*: Metro's
# virtual env module does `require.context(projectRoot, false, /^\.\/\.env/)`
# to support env-file hot reloading, which eagerly Babel-parses every
# top-level file starting with ".env" (even ones it never actually reads) —
# a file pulled via `eas env:pull` starts with a "# Environment: ..." comment
# line, which isn't valid JS and crashes the bundler. Populate it with
# `pnpm eas:pull:prod`; it's read explicitly by scripts/build-prod-local.sh,
# never auto-loaded by Expo or swept into the Metro bundle.

EXPO_PUBLIC_API_BASE_URL="http://localhost:4040"
EXPO_PUBLIC_POSTHOG_API_KEY="<posthog-public-key>"
EXPO_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
EXPO_PUBLIC_SENTRY_DSN="<sentry-public-dsn>"
