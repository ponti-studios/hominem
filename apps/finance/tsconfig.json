{
  "extends": "../../tsconfig.profiles/web-app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./.cache/tsconfig.tsbuildinfo",
    "rootDirs": [".", "./.react-router/types"],
    // Not part of the root project-reference graph (this app builds via
    // vite/react-router, not tsc), so composite mode's strict file-list
    // enforcement only gets in the way of the @hominem/api/finance path
    // alias below, which points outside this project's own file set.
    "composite": false,
    // @hominem/api/finance is type-only here (see app/lib/api.server.ts) —
    // not a real runtime dependency, so it isn't listed in package.json.
    // Keep this path in sync with services/api/package.json's "./finance"
    // export. Both app/lib/api.server.ts (the SSR client) and
    // app/lib/api/provider.tsx (the browser client, via
    // @hominem/rpc/finance's createFinanceApiClient) deliberately use this
    // narrow per-domain AppType (financeRoutes) instead of the root
    // @hominem/api/types export, so tsserver here never has to include
    // career/chats/notes/etc.'s type graph (docs/type-performance.md). The
    // Keep the root API contract on emitted declarations too: @hominem/rpc
    // exposes a shared client type that references @hominem/api/types.
    //
    // @hominem/finance-services below isn't this app's own dependency
    // either — services/api's build/rpc/routes/finance.d.ts preserves
    // `import("@hominem/finance-services")`-style references literally
    // instead of inlining them, so this consumer has to resolve that
    // specifier itself, same injectWorkspacePackages trap services/api's
    // own tsconfig.emit.json already routes around for its own compile
    // (docs/type-performance.md).
    "paths": {
      "~/*": ["./app/*"],
      "@hominem/api/types": ["../../services/api/build/rpc/app.d.ts"],
      "@hominem/api/finance": ["../../services/api/build/rpc/routes/finance.d.ts"],
      "@hominem/finance-services": ["../../packages/finance/build/index.d.ts"]
    }
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    ".react-router/types/**/*",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "exclude": [
    "node_modules",
    "build",
    "dist",
    ".turbo",
    ".cache",
    "coverage",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/__tests__",
    "**/__mocks__",
    "*.tsbuildinfo",
    ".react-router/cache"
  ],
  "references": [
    { "path": "../../packages/auth" },
    { "path": "../../packages/env" },
    { "path": "../../packages/queues" },
    { "path": "../../packages/utils" }
  ]
}
