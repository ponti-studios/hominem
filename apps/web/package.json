{
  "name": "@hominem/web",
  "private": true,
  "type": "module",
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "oxlint app",
    "format": "oxfmt app --write",
    "format:check": "oxfmt app --check",
    "build": "react-router build",
    "doctor": "react-doctor app --verbose --no-supply-chain --no-score",
    "dev": "portless",
    "dev:app": "react-router dev",
    "dev:clean": "rm -rf node_modules/.vite && react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "test": "vitest run --config vitest.config.ts --passWithNoTests",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "typecheck": "react-router typegen && rm -rf .cache && tsc --noEmit"
  },
  "dependencies": {
    "@hominem/chat": "workspace:*",
    "@hominem/env": "workspace:*",
    "@hominem/rpc": "workspace:*",
    "@hominem/storage": "workspace:*",
    "@hominem/telemetry": "workspace:*",
    "@hominem/utils": "workspace:*",
    "@ponti-studios/auth": "workspace:*",
    "@ponti-studios/ui": "catalog:",
    "@preact/signals-react": "^3.1.1",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@react-router/node": "catalog:",
    "@react-router/serve": "catalog:",
    "@rive-app/react-webgl2": "^4.32.1",
    "@rive-app/webgl2": "2.40.1",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/react-query": "catalog:",
    "@uppy/core": "^4.5.2",
    "@uppy/xhr-upload": "^4.2.3",
    "better-auth": "catalog:",
    "class-variance-authority": "^0.7.1",
    "clsx": "catalog:",
    "cmdk": "^1.1.1",
    "dotenv": "catalog:",
    "i18next": "^25.7.3",
    "isbot": "^5",
    "lucide-react": "catalog:",
    "motion": "^13.1.1",
    "nanoid": "^6.0.1",
    "posthog-js": "^1.363.3",
    "radix-ui": "^1.6.7",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "recharts": "3.10.1",
    "shiki": "^3.19.0",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.2.0",
