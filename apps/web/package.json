{
  "name": "@hominem/web",
  "private": true,
  "type": "module",
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "oxlint app",
    "format": "oxfmt app --write",
    "format:check": "oxfmt app --check",
    "build": "react-router build",
    "doctor": "react-doctor app --verbose --no-supply-chain --no-score",
    "dev": "portless",
    "dev:app": "react-router dev",
    "dev:clean": "rm -rf node_modules/.vite && react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "test": "vitest run --config vitest.config.ts --passWithNoTests",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "typecheck": "react-router typegen && rm -rf .cache && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@hominem/env": "workspace:*",
    "@hominem/rpc": "workspace:*",
    "@hominem/telemetry": "workspace:*",
    "@hominem/utils": "workspace:*",
    "@ponti-studios/auth": "workspace:*",
    "@ponti-studios/ui": "catalog:",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@react-router/node": "catalog:",
    "@react-router/serve": "catalog:",
    "@tanstack/react-query": "catalog:",
    "better-auth": "catalog:",
    "class-variance-authority": "^0.7.1",
    "clsx": "catalog:",
    "date-fns": "4.4.0",
    "dotenv": "catalog:",
    "isbot": "^5",
    "lucide-react": "catalog:",
    "motion": "^14.4.0",
    "posthog-js": "^1.445.3",
    "radix-ui": "^1.8.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "^7.90.0",
    "react-image-crop": "^11.0.10",
    "react-router": "catalog:",
    "recharts": "3.10.1",
    "simple-icons": "16.35.0",
    "tailwind-merge": "^3.7.0",
    "workbox-window": "^7.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@react-router/dev": "catalog:",
    "@storybook/react-vite": "^10.6.3",
    "@tailwindcss/vite": "^4.1.8",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "^30.1.3",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.3",
    "react-doctor": "^0.9.18",
    "rollup-plugin-visualizer": "6.0.5",
    "storybook": "^10.6.3",
    "tailwindcss": "^4.1.8",
    "tw-animate-css": "^1.3.4",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-pwa": "^2.0.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "portless": {
    "name": "web",
    "script": "dev:app"
  }
}
