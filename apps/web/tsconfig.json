{
  "extends": "../../tsconfig.profiles/web-app.json",
  "compilerOptions": {
    "rootDirs": [".", "./.react-router/types"],
    "tsBuildInfoFile": "./.cache/tsconfig.tsbuildinfo",
    // Not part of the root project-reference graph (this app builds via
    // vite/react-router, not tsc), so composite mode's strict file-list
    // enforcement only gets in the way of the @hominem/api/types path
    // alias below, which points outside this project's own file set.
    "composite": false,
    // App typechecking consumes emitted package declarations. Do not let a
    // stale local tsbuildinfo file hide changed exports in CI.
    "incremental": false,
    // @hominem/api/types is type-only (see packages/rpc/src/core/api-client.ts)
    // — not a real runtime dependency, so it isn't listed in package.json.
    // Keep this path in sync with services/api/package.json's "./types" export.
    //
    // @hominem/db, @hominem/career-services, @hominem/ai, and
    // @hominem/finance-services below aren't this app's own dependencies —
    // services/api's build/rpc/app.d.ts (the Hono AppType) preserves
    // `import("@hominem/career-services").JobImportErrorCode`-style
    // references literally instead of inlining them, so every consumer of
    // that .d.ts has to resolve those specifiers itself and hits the same
    // injectWorkspacePackages trap services/api's own tsconfig.emit.json
    // already routes around for its own compile (docs/type-performance.md).
    "paths": {
      "~/*": ["./app/*"],
      "@hominem/api/types": ["../../services/api/build/rpc/app.d.ts"],
      "@hominem/db": ["../../packages/db/build/index.d.ts"],
      "@hominem/career-services": ["../../packages/career/build/index.d.ts"],
      "@hominem/ai": ["../../packages/ai/build/index.d.ts"],
      "@hominem/finance-services": ["../../packages/finance/build/index.d.ts"]
    }
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    ".react-router/types/**/*",
    "vite.config.ts",
    ".storybook/**/*"
  ],
  "exclude": [
    "node_modules",
    "build",
    "dist",
    ".turbo",
    ".cache",
    "coverage",
    ".react-router/cache",
    "*.tsbuildinfo"
  ],
  "references": [
    { "path": "../../packages/auth" },
    { "path": "../../packages/env" },
    { "path": "../../packages/telemetry" },
    { "path": "../../packages/utils" }
  ]
}
