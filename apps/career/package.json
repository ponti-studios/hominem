{
  "name": "@hominem/career",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build && mkdir -p build/lib && cp -R app/lib/prompts build/lib/",
    "dev": "portless",
    "dev:app": "react-router dev",
    "dev:clean": "rm -rf node_modules/.vite && react-router dev",
    "dev:debug": "node --inspect-brk ./node_modules/.bin/react-router dev",
    "lint": "oxlint app tests",
    "lint:fix": "oxlint app tests --fix",
    "format": "oxfmt app tests --write",
    "generate:icons": "iconkit public/favicon.png",
    "format:check": "oxfmt app tests --check",
    "preview": "pnpm build && vite preview",
    "start": "react-router-serve ./build/server/index.js --port=${PORT:-3000}",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "react-router typegen && rm -rf .cache && tsc --noEmit",
    "gallery:screenshot": "jiti scripts/gallery-screenshot.ts",
    "gallery:login": "jiti scripts/gallery-login.ts"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@hominem/ai": "workspace:*",
    "@hominem/career-services": "workspace:*",
    "@hominem/db": "workspace:*",
    "@hominem/env": "workspace:*",
    "@hominem/queues": "workspace:*",
    "@hominem/rpc": "workspace:*",
    "@hominem/storage": "workspace:*",
    "@hominem/utils": "workspace:*",
    "@ponti-studios/auth": "workspace:*",
    "@ponti-studios/ui": "catalog:",
    "@react-router/node": "catalog:",
    "@react-router/serve": "catalog:",
    "@tanstack/react-query": "catalog:",
    "better-auth": "catalog:",
    "clsx": "catalog:",
    "date-fns": "4.4.0",
    "dotenv": "catalog:",
    "hono": "catalog:",
    "isbot": "^5.1.27",
    "lucide-react": "catalog:",
    "pdf2json": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "^7.57.0",
    "react-image-crop": "^11.0.10",
    "react-router": "catalog:",
    "simple-icons": "16.30.0",
    "tailwind-merge": "^3.3.0",
    "workbox-window": "^7.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@react-router/dev": "catalog:",
    "@tailwindcss/vite": "^4.1.8",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "4.1.11",
    "jiti": "catalog:",
    "jsdom": "^30.0.1",
    "msw": "^2.12.13",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.1.8",
    "tw-animate-css": "^1.3.4",
    "vite": "catalog:",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "catalog:"
  },
  "portless": {
    "name": "career",
    "script": "dev:app"
  }
}
