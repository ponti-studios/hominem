# Served by portless (each app declares its own name/port via the
# "portless" key in its package.json) at a stable name, independent of
# whatever port the api/career dev servers actually land on. The portless
# proxy itself runs on the default HTTPS port 443
# (`sudo pnpm exec portless proxy start --port 443 --tld lvh.me`), so no
# port suffix is needed here.
# lvh.me (not .localhost) so the cross-subdomain session cookie actually
# works — see AUTH_COOKIE_DOMAIN in services/api/.env.example.
VITE_PUBLIC_API_URL=https://api.lvh.me
PUBLIC_APP_URL=https://career.lvh.me
# Required server-only base URL for session checks. Use the API's Railway-private URL in production.
HOMINEM_INTERNAL_API_URL=https://api.lvh.me

# AI
OPENROUTER_API_KEY=

# Data
DATABASE_URL=

# Storage
R2_ENDPOINT=http://localhost:9000
R2_PUBLIC_URL=http://localhost:9000
R2_BUCKET_NAME=storage
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
