{
  "name": "hominem",
  "private": true,
  "description": "hominem",
  "keywords": [],
  "homepage": "https://github.com/hackefeller/hominem#readme",
  "bugs": {
    "url": "https://github.com/hackefeller/hominem/issues"
  },
  "license": "ISC",
  "author": {
    "name": "chase bridges",
    "email": "code@hominem.io",
    "url": "https://ponti.io/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hackefeller/hominem.git"
  },
  "scripts": {
    "prepare": "sh scripts/install-git-hooks.sh",
    "build": "turbo run build",
    "check": "DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:4433/hominem-test pnpm run check:all",
    "check:all": "pnpm run check:dts && pnpm run lint && pnpm run build && pnpm run typecheck && pnpm run test",
    "clean:ts": "find . -name node_modules -prune -o -type d \\( -name .cache -o -name build -o -name dist \\) -print -exec rm -rf {} +",
    "dev": "turbo run dev --ui stream --filter='!@hominem/omiro'",
    "dev:api": "turbo run dev --filter @hominem/api",
    "dev:career": "turbo run dev --filter @hominem/career",
    "dev:finance": "turbo run dev --filter @hominem/finance",
    "dev:web": "turbo run dev --filter @hominem/web",
    "dev:types": "bash scripts/watch-types.sh",
    "dev:worker": "pnpm run --filter @hominem/api dev:worker",
    "mobile:prebuild": "pnpm --filter @hominem/omiro prebuild:dev",
    "mobile:dev": "pnpm --filter @hominem/omiro dev",
    "mobile:ios": "pnpm --filter @hominem/omiro run:ios",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "test": "DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:4433/hominem-test turbo run test",
    "typecheck": "turbo run typecheck",
    "ui:check-canonical": "test ! -e packages/ui && ! rg -n '@hominem/ui' --glob '!node_modules/**' --glob '!package.json' .",
    "check:dts": "bash scripts/check-src-declarations.sh"
  },
  "dependencies": {
    "@ponti-studios/ui": "catalog:"
  },
  "devDependencies": {
    "@expo/image-utils": "^0.11.4",
    "@expo/prebuild-config": "~56.0.16",
    "@types/node": "catalog:",
    "@types/pg": "^8.18.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@xmldom/xmldom": "0.9.12",
    "knip": "^6.4.1",
    "oxfmt": "0.56.0",
    "oxlint": "^1.71.0",
    "portless": "0.15.6",
    "react-doctor": "^0.9.12",
    "turbo": "^2.10.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "packageManager": "pnpm@11.23.0+sha512.03f29ca5d9e6d8d91898fd4473fe9ef33dc7fc62f730ba32abb9fb98cfe3860c33f98e87e9ce2eb3cddc53214aa9019222993f054f470a34ac41fee62139ef5a"
}
