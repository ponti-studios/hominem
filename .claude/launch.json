{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@hominem/web", "dev"],
      "port": 4445,
      "autoPort": true,
      "url": "http://localhost:4445"
    },
    {
      "name": "ui-storybook",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd $HOME/Developer/ui && pnpm exec storybook dev -p 6006 --ci"],
      "port": 6006
    },
    {
      "name": "web-storybook",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@hominem/web", "storybook"],
      "port": 6006
    }
  ]
}
