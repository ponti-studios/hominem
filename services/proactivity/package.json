{
  "name": "@hominem/proactivity",
  "version": "0.0.0",
  "description": "Goal-centered proactive evaluation engine",
  "type": "module",
  "sideEffects": false,
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf build .cache && tsc -p tsconfig.json",
    "typecheck": "rm -rf .cache && tsc --noEmit",
    "test": "vitest run",
    "format": "oxfmt src --write",
    "format:check": "oxfmt src --check",
    "lint": "oxlint src"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
