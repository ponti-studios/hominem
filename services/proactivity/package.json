{
  "name": "@hominem/proactivity",
  "version": "0.0.0",
  "description": "Goal-centered proactive evaluation engine",
  "type": "module",
  "sideEffects": false,
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    },
    "./openrouter": {
      "types": "./build/openrouter-slot.d.ts",
      "import": "./build/openrouter-slot.js"
    }
  },
  "scripts": {
    "build": "rm -rf build .cache && tsc -p tsconfig.json",
    "typecheck": "rm -rf .cache && tsc --noEmit",
    "test": "vitest run src",
    "eval": "tsx src/evals/run.ts",
    "eval:live": "tsx src/evals/run.ts --live",
    "demo": "tsx src/evals/server.ts",
    "demo:report": "tsx src/evals/demo.ts",
    "format": "oxfmt src --write",
    "format:check": "oxfmt src --check",
    "lint": "oxlint src"
  },
  "dependencies": {
    "@hominem/ai": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
