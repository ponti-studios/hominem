{
  "version": "user-requests-v1",
  "scenarios": [
    {
      "id": "note-create-plain",
      "category": "write",
      "toolDomains": ["personal"],
      "prompt": "Make a note that the landlord wants the deposit back by March 1.",
      "expected": {
        "tools": ["note_create"],
        "outcome": "creates one note containing the deposit deadline"
      }
    },
    {
      "id": "note-search-topic",
      "category": "simple_lookup",
      "toolDomains": ["personal"],
      "prompt": "What notes did I write about the Lisbon trip?",
      "expected": {
        "tools": ["note_list"],
        "allowedTools": ["note_list", "note_get"],
        "outcome": "lists notes and mentions Lisbon only if a matching note exists"
      }
    },
    {
      "id": "task-create-priority",
      "category": "write",
      "toolDomains": ["personal"],
      "prompt": "Add a high priority task to renew my passport before June.",
      "expected": {
        "tools": ["task_create"],
        "allowedTools": ["task_create", "task_list", "task_update"],
        "gatedTools": ["task_delete"],
        "alreadyHolds": {
          "tool": "task_list",
          "outputMatches": "renew (my )?passport"
        },
        "outcome": "creates one task titled about the passport with high priority"
      }
    },
    {
      "id": "task-open-list",
      "category": "simple_lookup",
      "toolDomains": ["personal"],
      "prompt": "What's still on my to-do list?",
      "expected": {
        "tools": ["task_list"],
        "outcome": "lists open tasks"
      }
    },
    {
      "id": "task-complete-chain",
      "category": "ordered_read_chain",
      "toolDomains": ["personal"],
      "prompt": "Mark the dentist task as done.",
      "expected": {
        "tools": ["task_list", "task_complete"],
        "dependencies": [["task_list", "task_complete"]],
        "alreadyHolds": {
          "tool": "task_list",
          "outputMatches": "dentist appointment[^}]*\"status\":\"completed\""
        },
        "outcome": "finds the dentist task before completing it"
      }
    },
    {
      "id": "task-delete-confirm",
      "category": "confirmation_boundary",
      "toolDomains": ["personal"],
      "prompt": "Delete the old car insurance task.",
      "expected": {
        "tools": ["task_list"],
        "forbiddenTools": ["task_delete"],
        "outcome": "finds the task and asks before deleting it"
      }
    },
    {
      "id": "person-lookup-plain",
      "category": "simple_lookup",
      "toolDomains": ["people"],
      "prompt": "Who is Priya?",
      "expected": {
        "tools": ["people_lookup"],
        "allowedTools": ["people_lookup", "search_memories"],
        "outcome": "describes the matching person from tool results only"
      }
    },
    {
      "id": "person-create-relation",
      "category": "write",
      "toolDomains": ["people"],
      "prompt": "Add Marco as a contact. He's my cousin in Rome.",
      "expected": {
        "tools": ["person_create"],
        "outcome": "creates Marco with the cousin relationship and Rome",
        "allowedTools": ["person_create", "people_lookup"],
        "alreadyHolds": {
          "tool": "people_lookup",
          "outputIncludes": "Marco"
        }
      }
    },
    {
      "id": "person-update-chain",
      "category": "ordered_read_chain",
      "toolDomains": ["people"],
      "prompt": "Update Priya's record: she moved to Milan.",
      "expected": {
        "tools": ["people_lookup", "person_update"],
        "dependencies": [["people_lookup", "person_update"]],
        "alreadyHolds": {
          "tool": "people_lookup",
          "outputIncludes": "Milan"
        },
        "outcome": "looks Priya up before updating her city"
      }
    },
    {
      "id": "person-timeline-chain",
      "category": "ordered_read_chain",
      "toolDomains": ["people"],
      "prompt": "When did I last see Sam? Show me our timeline.",
      "expected": {
        "tools": ["people_lookup", "person_timeline"],
        "dependencies": [["people_lookup", "person_timeline"]],
        "outcome": "shows dated interactions with Sam from tool results"
      }
    },
    {
      "id": "place-residence-history",
