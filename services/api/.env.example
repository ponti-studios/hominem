# API service
NODE_ENV="development"
# Set to scripted to mock both AI and email providers.
ENV=""
# No default — Fly sets PORT per deployed service (api vs. worker).
# Falls back to 4040 (api) / 4041 (worker health check) locally when unset.
PORT=4040
# dev:worker's health-check server — must differ from PORT above so it doesn't
# steal the main API's port when both run locally from this same .env file.
WORKER_PORT=4041
# Served by portless (each app declares its own name/port via the
# "portless" key in its package.json — see the hominem-development skill)
# at a stable name, independent of whatever port each app actually lands
# on. Falls back to the fixed ports above if you run apps without
# `pnpm dev` / portless. The portless proxy itself runs on the default
# HTTPS port 443 (`sudo pnpm exec portless proxy start --port 443 --tld
# lvh.me`), not any individual app's port, so no port suffix is needed here.
API_URL="https://api.lvh.me"
WEB_URL="https://web.lvh.me"
CAREER_URL="https://career.lvh.me"
FINANCE_URL="https://finance.lvh.me"
# Trusted origins for the hosted-login app-redirect mode: labs (labyrinth) is a
# separate repo served by the same portless proxy at https://labyrinth.lvh.me.
LABS_URL="https://labyrinth.lvh.me"

# Newsboy is a separate app and must be trusted as a hosted-login return origin.
NEWSBOY_URL="https://newsboy.lvh.me"

# Optional second trusted origin for labs when it is also served at an apex domain.
LABS_APEX_URL="http://localhost:3001"

# Data and queues
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5434/hominem"
REDIS_URL="redis://localhost:6379"

# Authentication
# Required — no default. Better Auth signs session cookies with this secret;
# the process fails to boot without it.
BETTER_AUTH_SECRET=""
# Required for local login to work at all: under portless, api/web/career/
# finance each get their own https://<name>.lvh.me subdomain, so
# without a shared cookie domain the session cookie set during hosted login
# stays scoped to api.lvh.me and never reaches the other apps' origins.
# "lvh.me" enables Better Auth's crossSubDomainCookies across all of them.
# It must be a real registrable domain, not .localhost — browsers (Chrome
# confirmed) silently refuse to set a Domain=localhost cookie at all, even
# though the response's Set-Cookie header looks correct. lvh.me is a public
# domain with wildcard DNS to 127.0.0.1 (like nip.io), so it isn't subject
# to that restriction; apps/*/playwright.config.ts already relies on the
# same fact for e2e cross-subdomain auth.
AUTH_COOKIE_DOMAIN="lvh.me"
AUTH_EMAIL_OTP_EXPIRES_SECONDS="300"

# RPC and service integrations

# Email
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
RESEND_FROM_NAME=""
# Email provider. Leave empty to infer: production sends real email, every
# other NODE_ENV captures to "scripted" (see src/testkit/resend.mock.ts),
# which intercepts the outbound Resend HTTP call instead of sending — the OTP
# itself is still the real randomly generated code. Scripted is refused in
# production.
# Captures are appended to a local JSONL mailbox (HOMINEM_SCRIPTED_MAILBOX,
# default ~/.hominem/scripted-mailbox.jsonl) that same-host E2E helpers read
# back. OTPs are never retrievable over the API by design.
# Override for the scripted-provider OTP mailbox location; empty means the
# default above.
HOMINEM_SCRIPTED_MAILBOX=""

# AI
CHAT_MODEL="openai/gpt-6-luna"
EMBEDDING_MODEL="google/gemini-embedding-2"
ENHANCE_MODEL="openai/gpt-5-mini"
FILE_ANALYSIS_MODEL="openai/gpt-5-mini"
RESUME_PARSE_MODEL="openai/gpt-5-mini"
OPENROUTER_API_KEY=""
# Creates, reads and disables the per-person keys handed to Thames (POST /api/credentials).
# A management key from OpenRouter; without it that endpoint answers 503. Never on a device.
OPENROUTER_MANAGEMENT_KEY=""
# Per-person monthly budget for those keys, in USD.
THAMES_MONTHLY_CAP_USD=5
# TestFlight public link; emailed as a QR code to allowed domains only
THAMES_TESTFLIGHT_URL=
# Thames website origin (CORS for the invite form)
THAMES_SITE_URL=
AUDIO_TTS_MODEL="microsoft/mai-voice-2-flash"
AUDIO_TTS_VOICE="en-US-Harper:MAI-Voice-2"
TIME_BLOCK_EXTRACTION_MODEL="z-ai/glm-5.3-flash"
VOICE_CLEANUP_MODEL="openai/gpt-5-mini"
TASK_EXTRACTION_MODEL="openai/gpt-5-mini"
SAVE_VOICE_AUDIO="false"

# Storage
R2_ENDPOINT=http://localhost:9000
R2_PUBLIC_URL=http://localhost:9000
R2_BUCKET_NAME=storage
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin

# Observability
OPENAI_APPS_CHALLENGE=""
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
OTEL_EXPORTER_OTLP_PROTOCOL="http/protobuf"
OTEL_EXPORTER_OTLP_HEADERS=""
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=""
OTEL_EXPORTER_OTLP_LOGS_HEADERS=""
OTEL_SERVICE_NAME="api"
OTEL_DEPLOYMENT_ENVIRONMENT="development"
OTEL_TRACES_SAMPLER_ARG="0.1"
OTEL_LOGS_EXPORTER="http/protobuf"

# Thames credit (docs/prd/top-up.md in the Thames repo). Off unless set. `test` needs Stripe test keys
# and lets in only CREDIT_TESTERS (emails, or whole domains); `live` needs live keys.
CREDIT_MODE=off
CREDIT_TESTERS=
# In `test`, the PostHog flag `thames-top-up` also lets a person in (target them in PostHog). Unset
# means the flag is never asked and CREDIT_TESTERS alone decides. A lookup that fails counts as off.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Dollars per pound, already lowered by a small buffer. Review monthly.
CREDIT_USD_PER_POUND=1.28
CREDIT_GRANT_PENCE=100
CREDIT_GRANTS_PER_DAY=50

# Subscription billing (docs/billing.md). The webhook endpoint's own signing secret; falls back to
# STRIPE_WEBHOOK_SECRET when both Stripe endpoints share one.
BILLING_STRIPE_WEBHOOK_SECRET=
# Monthly caps. The "Hominem — Paid Tier Plan" sheet is the source of truth; these are the values
# currently deployed. Every chat cap is finite, so no tier has uncapped conversation.
BILLING_TASTER_CHAT_MESSAGES=50
BILLING_CORE_CHAT_MESSAGES=1000
BILLING_AI_CHAT_MESSAGES=3000
BILLING_TASTER_SKILL_CALLS=500
