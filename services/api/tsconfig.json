{
  "extends": "../../tsconfig.profiles/service.json",
  "compilerOptions": {
    "composite": false,
    // This package consumes inferred declarations across the chat/RPC
    // boundary; stale tsbuildinfo can hide dependency type changes.
    "incremental": false,
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "lib": ["ESNext", "DOM"],
    "tsBuildInfoFile": "./.cache/tsconfig.tsbuildinfo",
    // NOTE: rolldown's build.mjs reads *this* file directly
    // (`tsconfig: './tsconfig.json'`) for its own runtime bundling, so
    // `paths` here must only ever redirect to real, bundleable modules.
    // See tsconfig.emit.json for the type-check-only `paths` override --
    // it does not extend into rolldown's build.
    "paths": {
      "@/*": ["./*"]
    }
  },
  // import-meta-env.d.ts is @hominem/env's ambient `ImportMeta.env` declaration. When env's
  // build/*.d.ts are absent (the Docker build never builds it) its source is compiled inside this
  // program, and without the declaration `import.meta.env` fails to typecheck.
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite-env.d.ts",
    "../../packages/env/src/import-meta-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    ".turbo",
    ".cache",
    "coverage",
    "*.tsbuildinfo",
    // The client-rendered auth UI compiles with React's JSX runtime under its
    // own tsconfig.auth-ui.json; the server tsconfig pins hono/jsx for the
    // hosted pages, so the React app is typechecked separately.
    "src/routes/login/app"
  ]
  // Deliberately NOT itself composite, and deliberately NO `references`
  // entries at all (see AGENTS.md's "Package that infers types across other
  // packages" section): rpc/app.ts's `typeof rpcApp` inference re-exports
  // types from these packages (AIUsageFeature, AffordabilityVerdict, ...),
  // and TS's "portable type" check (TS2883) can refuse to infer AppType
  // across a real composite project boundary without an explicit
  // annotation, defeating Hono's RPC type-inference pattern. A bare
  // `references` entry to a single package (e.g. packages/chat alone) does
  // pass a full `tsc --noEmit` today -- verified empirically -- but
  // AGENTS.md's zero-references invariant exists to hold as the AppType
  // contract evolves, not just for today's shape. Every dependency here
  // (packages/chat included) resolves via plain source/paths to build/*.d.ts
  // instead; scripts/watch-types.sh's composite watcher is what keeps that
  // fresh during development.
}
