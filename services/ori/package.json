{
  "name": "@hominem/ori",
  "private": true,
  "type": "module",
  "scripts": {
    "eval": "tsx runner/cli.ts",
    "eval:check": "tsx runner/mcp-tool-catalog.ts && tsx runner/cli.ts check",
    "eval:catalog:update": "tsx runner/mcp-tool-catalog.ts --write",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "format": "oxfmt evals runner --write '!evals/**/*.html' '!evals/**/*.generated.json'",
    "format:check": "oxfmt evals runner --check '!evals/**/*.html' '!evals/**/*.generated.json'"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "promptfoo": "0.124.1",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
