{
  "name": "@hominem/ori",
  "private": true,
  "scripts": {
    "format": "oxfmt evals types --write '!evals/**/*.html'",
    "format:check": "oxfmt evals types --check '!evals/**/*.html'",
    "typecheck": "tsc -p tsconfig.json",
    "eval:chat-assistant": "ori eval evals/chat/assistant/assistant.eval.ts",
    "eval:chat-baseline": "ori eval evals/chat/assistant/baseline.eval.ts",
    "eval:career-job-import": "ori eval evals/career/job-import/job-import.eval.ts",
    "eval:mcp-travel-presence": "ori eval evals/mcp/domains/travel/presence-evidence/presence-evidence.eval.ts",
    "eval:mcp-agent-protocol": "bun test ./evals/mcp/protocol/agent-protocol.eval.ts",
    "eval:career-offer-extraction": "ori eval evals/career/offer-extraction/offers.eval.ts",
    "eval:task-extraction": "ori eval evals/extraction/tasks/tasks.eval.ts",
    "eval:time-block-regression": "ori eval evals/scheduling/time-block/regression.eval.ts",
    "eval:time-block-holdout": "ori eval evals/scheduling/time-block/holdout.eval.ts",
    "eval:voice-cleanup": "ori eval evals/voice/transcript-cleanup/transcript-cleanup.eval.ts",
    "eval:voice-task-extraction": "ori eval evals/voice/task-extraction/task-extraction.eval.ts",
    "eval:all": "ori eval evals",
    "eval:list": "ori eval --list --allow-no-key evals",
    "eval:pilot": "ori eval --pilot 1 evals",
    "eval:mcp-tool-routing": "ori eval evals/mcp/agent/tool-routing/tool-routing.eval.ts",
    "eval:mcp-workflow-planning": "ori eval evals/mcp/agent/workflow-planning/workflow-planning.eval.ts",
    "eval:mcp-monthly-review": "ori eval evals/mcp/domains/finance/monthly-review/monthly-review.eval.ts"
  }
}
